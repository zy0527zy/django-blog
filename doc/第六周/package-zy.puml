@startuml 系统整体包图
' 软工3班8组 第六周实践任务 —— 系统架构图（UML 包图）
' 依据：src/djangoblog/settings.py 的 INSTALLED_APPS 与 djangoblog 核心包实际文件
' 说明：plugins 不在 INSTALLED_APPS 中，由 plugin_manage.loader 按 ACTIVE_PLUGINS 动态加载
' 生成工具：PlantUML

skinparam defaultFontName "Microsoft YaHei"
skinparam packageStyle rectangle
skinparam ArrowColor #2c3e50
skinparam backgroundColor #ffffff
skinparam package {
  BackgroundColor #f4f6f8
  BorderColor #34495e
}

package "djangoblog（核心项目包）" as core {
  [settings.py\n全局配置]
  [urls.py\n全局路由]
  [wsgi.py / apps.py\n部署与应用启动]
  [admin_site.py / logentryadmin.py\n自定义后台站点]
  [base_views.py / error_views.py\n视图基类与错误页]
  [mixins.py / utils.py / constants.py\n混入 / 工具 / 常量]
  [blog_signals.py / feeds.py\nsitemap.py / spider_notify.py\n信号 / RSS / 站点地图 / 推送]
  [elasticsearch_backend.py\nwhoosh_cn_backend.py\n搜索后端]
  [plugin_manage\nloader / hooks / BasePlugin]
}

package "blog\n（博客）" as blog
package "accounts\n（用户）" as accounts
package "comments\n（评论）" as comments
package "oauth\n（第三方登录）" as oauth
package "servermanager\n（服务器管理）" as sm
package "plugins\n（动态加载）" as plugins
package "三方依赖\nmdeditor / haystack / compressor" as third

core --> blog : 注册 / 路由分发
core --> accounts : 注册 / 路由分发
core --> comments : 注册 / 路由分发
core --> oauth : 注册 / 路由分发
core --> sm : 注册 / 路由分发
core --> plugins : loader 按 ACTIVE_PLUGINS 动态加载
core --> third : 依赖

blog --> accounts : Article.author 外键
comments --> blog : Comment.article 外键
comments --> accounts : Comment.author 外键
oauth --> accounts : OAuthUser.author 外键
plugins --> blog : hooks 钩子注入
plugins --> comments : hooks 钩子注入
@enduml
